{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OptHuang/ORBenchLab/schemas/plan_ledger.schema.json",
  "title": "Plan ledger",
  "description": "Written at compile time, before anything executes. Harbor names trials randomly, so a trial cannot carry an ORBenchLab run id; ingest reconciles trials to entries by match_key. A trial matching no entry is an orphan and is recorded as such.",
  "type": "object",
  "required": [
    "ledger_schema_version",
    "campaign_id",
    "campaign_cfg_digest",
    "written_before_execution",
    "match_key_definition",
    "reconciliation_rules",
    "entries"
  ],
  "properties": {
    "ledger_schema_version": { "type": "string", "const": "1.0" },
    "campaign_id": { "type": "string" },
    "campaign_cfg_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "written_before_execution": { "type": "boolean", "const": true },
    "match_key_definition": { "type": "string" },
    "reconciliation_rules": {
      "type": "object",
      "required": ["multiple_ledger_hits", "no_ledger_hit", "one_job_per"],
      "properties": {
        "multiple_ledger_hits": { "type": "string" },
        "no_ledger_hit": { "type": "string" },
        "one_job_per": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "shard",
          "task_uid",
          "task_name",
          "agent_uid",
          "budget_uid",
          "seed",
          "attempt",
          "job_name",
          "match_key"
        ],
        "properties": {
          "run_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "shard": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
          "task_uid": { "type": "string" },
          "task_name": { "type": "string" },
          "agent_uid": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "budget_uid": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "seed": { "type": "integer" },
          "attempt": { "type": "integer", "minimum": 1 },
          "job_name": { "type": "string" },
          "match_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
